+    /** Live TV tile: opens the IPTV website's own player in LiveTvActivity (embedded WebView). */
+    void addLiveTvEntry() {
+        AppEntry e = new AppEntry();
+        e.key = LIVETV_KEY;
+        e.pkg = getPackageName();
+        e.label = "Live TV";
+        e.system = true;
+        e.color = 0xFFDC2626;
+        e.launch = new Intent(this, LiveTvActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        int w = 640, h = 384;
+        Bitmap b = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+        Canvas c = new Canvas(b);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.DITHER_FLAG);
+        p.setShader(new LinearGradient(0, 0, w, h, 0xFFEF4444, 0xFF991B1B, Shader.TileMode.CLAMP));
+        c.drawRect(0, 0, w, h, p);
+        Bitmap g = Glyphs.get("antenna", (int) (h * 0.5f), Color.WHITE);
+        c.drawBitmap(g, (w - g.getWidth()) / 2f, (h - g.getHeight()) / 2f, null);
+        e.banner = new BitmapDrawable(getResources(), b);
+        e.icon = e.banner;
+        all.put(e.key, e);
+    }
